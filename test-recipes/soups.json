{"id": "s60-gazpacho", "name": "Gazpacho (no heat!)", "category": "soup", "difficulty": 2, "ingredients": ["tomato", "celery", "garlic", "oil", "vinegar", "salt", "water"], "steps": ["pour water 3s", "add tomato 12", "add celery 2", "add garlic 1", "pour oil 1s", "pour vinegar 0.6s", "pour salt 1s", "stir 6s", "serve"], "expect": {"discoveries": [], "physics": "The burner never turns on. Tomatoes stay whole chunks (they only melt when hot), so the 'soup' is mostly raw chunks in cold water.", "taste": {"sour": [0.2, 0.45], "salty": [0.35, 0.65]}, "notes": [], "flaws": ["raw"], "verdict": "CHOPPED"}, "sim_gaps": ["Needs a blend/mash tool so raw tomatoes can become liquid without heat; Nanny Mae penalises cold soup, which is correct only outside a Gazpacho brief."]},
{"id": "s61-reduction-test", "name": "Reduction Test Broth", "category": "soup", "difficulty": 2, "ingredients": ["water", "soy", "salt"], "steps": ["pour water 12s", "pour soy 1s", "pour salt 0.3s", "stir 3s", "taste", "heat 9", "wait 120s", "stir 3s", "taste", "serve"], "expect": {"discoveries": ["boil"], "physics": "Taste before and after a hard boil: the water line visibly drops and the second taste is noticeably saltier and more savory — flavor concentrates as water escapes.", "taste": {"salty": [0.45, 0.85], "umami": [0.25, 0.55]}, "notes": ["fermented"], "flaws": [], "verdict": "CHOPPED-SAFE"}, "sim_gaps": []},
{"id": "s62-lidded-onion", "name": "Lidded Onion Broth (aroma test)", "category": "soup", "difficulty": 2, "ingredients": ["oil", "onion", "garlic", "water", "salt", "herbs"], "steps": ["pour oil 1s", "add onion 5", "add garlic 2", "heat 5", "wait 40s", "pour water 10s", "pour salt 1s", "add herbs 1", "lid on", "heat 7", "wait 120s", "lid off", "taste", "serve"], "expect": {"discoveries": ["sweat"], "physics": "Lid on: steam condenses and drips back, the level doesn't drop, and aroma is retained. Compare with the same recipe lid-off: lid-off should have less aroma and be more concentrated.", "taste": {"aroma": [0.35, 0.7], "salty": [0.3, 0.55]}, "notes": ["allium", "herbal"], "flaws": [], "verdict": "SAFE"}, "sim_gaps": ["Herbs under a lidded boil still wilt (herbloss) — correct, but worth checking the aroma kept by the lid offsets it."]},
{"id": "s63-mehlsuppe", "name": "Browned Flour Soup (Mehlsuppe)", "category": "soup", "difficulty": 4, "ingredients": ["oil", "flour", "onion", "water", "salt", "cumin"], "steps": ["pour oil 2s", "heat 6", "pour flour 1.2s", "stir 4s", "wait 60s", "stir 3s", "wait 30s", "add onion 4", "wait 30s", "pour water 10s +stir", "pour cumin 0.2s", "pour salt 1s", "heat 4", "wait 60s", "serve"], "expect": {"discoveries": ["roux", "thicken", "sweat"], "physics": "Roux cooked long enough to go from blond to brown (more toasty flavor, slightly less thickening). Swiss peasant soup.", "taste": {"body": [0.3, 0.65], "aroma": [0.35, 0.7]}, "notes": ["toasty", "allium"], "flaws": [], "verdict": "SAFE"}, "sim_gaps": []},
{"id": "s64-cream-tomato-herb", "name": "Cream of Tomato & Herb", "category": "soup", "difficulty": 4, "ingredients": ["oil", "garlic", "tomato", "water", "milk", "sugar", "salt", "herbs"], "steps": ["pour oil 1s", "add garlic 2", "heat 5", "wait 15s", "add tomato 12", "wait 50s", "pour water 4s", "pour sugar 0.3s", "heat 2", "wait 20s", "pour milk 3s +stir", "pour salt 1s", "add herbs 2", "wait 10s", "serve"], "expect": {"discoveries": ["tomato"], "physics": "Sugar balances the acid and the heat is dropped to 2 before the milk: should stay smooth (contrast with s13).", "taste": {"sour": [0.1, 0.3], "rich": [0.3, 0.55], "sweet": [0.25, 0.5], "aroma": [0.35, 0.7]}, "notes": ["herbal", "allium"], "flaws": [], "verdict": "SAFE-WINNER"}, "sim_gaps": ["Curdle check uses sour vs dairy ratio, not pH; sugar doesn't actually protect dairy in the sim (correct in reality too)."]},
{"id": "s65-spiced-carrot-celery", "name": "Spiced Carrot & Celery Soup with Chili Oil", "category": "soup", "difficulty": 4, "ingredients": ["oil", "onion", "carrot", "celery", "water", "salt", "chili", "cumin"], "steps": ["pour oil 1s", "add onion 3", "add carrot 6", "add celery 4", "heat 5", "wait 50s", "pour water 9s", "pour salt 1s", "heat 4", "wait 120s", "pour oil 1s @right", "heat 6", "wait 12s", "pour chili 0.4s @right", "pour cumin 0.3s @right", "wait 6s", "stir 3s", "serve"], "expect": {"discoveries": ["sweat", "mirepoix"], "physics": "A finishing 'tadka': spices poured onto a fresh oil slick floating on the soup bloom right there, then get stirred through.", "taste": {"heat": [0.25, 0.55], "aroma": [0.45, 0.85], "sweet": [0.25, 0.5]}, "notes": ["spice", "earthy", "herbal"], "flaws": [], "verdict": "WINNER"}, "sim_gaps": ["A finishing tadka on oil floating over boiling soup can't get hotter than ~100°C, so the spices don't bloom; it needs a separate small pan."]},
{"id": "s66-poached-egg-broth", "name": "Poached Egg in Broth", "category": "soup", "difficulty": 3, "ingredients": ["water", "soy", "garlic", "egg", "herbs"], "steps": ["pour water 10s", "pour soy 1.5s", "add garlic 2", "heat 6", "wait 40s", "crack egg 1", "wait 25s", "add herbs 1", "serve"], "expect": {"discoveries": ["crack", "poached"], "physics": "A cracked egg dropped into a simmer and left alone sinks as a wobbly blob, slumps a little, and sets as one silky piece (white turns opaque, yolk stays golden).", "taste": {"salty": [0.25, 0.55], "umami": [0.15, 0.45]}, "notes": ["fermented", "allium"], "flaws": [], "verdict": "CHOPPED-SAFE"}, "sim_gaps": ["No runny-yolk vs hard-yolk distinction yet."]},
{"id": "s67-fish-soup", "name": "Simple Fish Soup", "category": "soup", "difficulty": 3, "ingredients": ["oil", "onion", "garlic", "tomato", "water", "fish", "salt", "herbs"], "steps": ["pour oil 1s", "add onion 4", "add garlic 2", "heat 5", "wait 40s", "add tomato 6", "wait 30s", "pour water 10s", "pour salt 1s", "wait 40s", "throw fish 1", "heat 4", "wait 70s", "add herbs 1", "serve"], "expect": {"discoveries": ["sweat", "tomato", "flake"], "physics": "The whole fish splashes into the simmering tomato broth (no damage: the liquid cushions it), turns opaque, then falls apart into flakes after about a minute.", "taste": {"umami": [0.3, 0.7], "sour": [0, 0.3], "aroma": [0.35, 0.7]}, "notes": ["oceanic", "allium"], "flaws": [], "verdict": "SAFE-WINNER"}, "sim_gaps": ["No fish bones."]},
{"id": "s68-hardboiled-egg-soup", "name": "Whole Hard-Boiled Egg Soup", "category": "soup", "difficulty": 2, "ingredients": ["water", "salt", "egg"], "steps": ["pour water 14s", "heat 7", "wait 30s", "throw egg 1", "wait 60s", "pour salt 1s", "stir 3s", "wait 5s", "serve"], "expect": {"discoveries": ["hardboil"], "physics": "The thrown egg slows as it hits deep water and survives whole. It cooks solid inside its shell — visible in cross-section as the white turning opaque.", "taste": {"salty": [0.3, 0.6]}, "notes": [], "flaws": ["shell"], "verdict": "CHOPPED"}, "sim_gaps": ["No peeling; the shell counts as a flaw."]}
